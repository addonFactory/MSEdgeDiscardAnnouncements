#: addon/appModules/msedge/interface/panel.py:128
msgid "Configure b&eeps..."
msgstr "配置提示音(&E)..."

#. Translators: The label of a button to choose the wave file played for the
#. notification.
#: addon/appModules/msedge/interface/panel.py:134
msgid "&Browse..."
msgstr "浏览(&B)..."

#. Translators: The label of a button to hear the wave file played for the
#. notification.
#: addon/appModules/msedge/interface/panel.py:140
msgid "&Play file"
msgstr "播放文件(&P)"

#. Translators: The label of a button to support the author of the add-on with
#. a donation.
#: addon/appModules/msedge/interface/panel.py:153
msgid "&Support the author..."
msgstr "支持作者(&S)..."

#. Translators: The title of the dialog to choose the wave file played for a
#. notification.
#: addon/appModules/msedge/interface/panel.py:205
msgid "Choose a wave file"
msgstr "选择音频文件"

#. Translators: The filter of the dialog to choose a wave file.
#: addon/appModules/msedge/interface/panel.py:207
msgid "Wave files"
msgstr "音频文件"

#. Translators: An action for a notification, meaning that it is not reported
#. at all.
#: addon/appModules/msedge/settings.py:44
msgid "Off"
msgstr "关闭"

#. Translators: An action for a notification, meaning that it is spoken.
#: addon/appModules/msedge/settings.py:46
