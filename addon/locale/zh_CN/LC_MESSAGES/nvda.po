#: addon/appModules/msedge/interface/beepDialogs.py:95
msgid "&Beeps"
msgstr "提示音序列(&B)"

#. Translators: The label of a button to add a beep to the pattern.
#: addon/appModules/msedge/interface/beepDialogs.py:103
msgid "&Add..."
msgstr "添加(&A)..."

#. Translators: The label of a button to change the selected beep of the
#. pattern.
#: addon/appModules/msedge/interface/beepDialogs.py:105
msgid "&Edit..."
msgstr "编辑(&E)..."

#. Translators: The label of a button to delete the selected beep from the
#. pattern.
#: addon/appModules/msedge/interface/beepDialogs.py:107
msgid "&Remove"
msgstr "移除(&R)"

#. Translators: The label of a button to play the selected beep earlier in the
#. pattern.
#: addon/appModules/msedge/interface/beepDialogs.py:109
msgid "Move &up"
msgstr "上移(&U)"

#. Translators: The label of a button to play the selected beep later in the
#. pattern.
#: addon/appModules/msedge/interface/beepDialogs.py:111
msgid "Move &down"
msgstr "下移(&D)"

#: addon/appModules/msedge/interface/beepDialogs.py:114
