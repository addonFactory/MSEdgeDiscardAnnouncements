#. Add-on summary, usually the user visible name of the addon.
#: addon.toml:10
msgid "Microsoft Edge discard announcements"
msgstr "Microsoft Edge 通知屏蔽"

#. Add-on description
#. Translators: Long description to be shown for this add-on on add-on
#. information from add-ons manager
#: addon.toml:14
msgid ""
"Discards UIA announcements in Microsoft Edge such as page loading and "
"refreshing, opening and closing tabs and windows and more."
msgstr ""
"屏蔽 Microsoft Edge 中的 UIA 通知，例如页面加载与刷新、打开与关闭标签页和窗口"
"等。"

#: addon/appModules/msedge/donate_dialog.py:24
msgid "Donate via Paypal"
msgstr "通过 Paypal 捐赠"

#: addon/appModules/msedge/donate_dialog.py:25
msgid "Donate via Yoomoney"
msgstr "通过 Yoomoney 捐赠"

#: addon/appModules/msedge/donate_dialog.py:39
#, python-brace-format
msgid "Request for contributions to {name}"
msgstr "欢迎为 {name} 提供捐助"

#: addon/appModules/msedge/donate_dialog.py:41
#, python-brace-format
msgid ""
"{name} is a free add-on for NVDA.\n"
"You can make a donation to its author to support further development of this "
"and other free projects.\n"
"Do you want to donate now? Choose one of the available payment methods. You "
"will be redirected to the corresponding website to complete a donation"
msgstr ""
"{name} 是 NVDA 的一款免费插件。\n"
"您可以向其作者捐赠，以支持本插件及其他免费项目的后续开发。\n"
"要现在捐赠吗？请选择一种可用的支付方式。您将被跳转到相应网站以完成捐赠"

#. Translators: The label of a control to choose the pitch of a beep.
#: addon/appModules/msedge/interface/beepDialogs.py:15
msgid "Fre&quency (Hz)"
msgstr "频率(&Q) (Hz)"

#. Translators: The label of a control to choose how long a beep lasts.
#: addon/appModules/msedge/interface/beepDialogs.py:17
msgid "&Length (ms)"
msgstr "长度(&L) (ms)"

#. Translators: The label of a control to choose the volume of a beep in the
#. left channel.
#: addon/appModules/msedge/interface/beepDialogs.py:19
msgid "L&eft volume (%)"
msgstr "左声道音量(&E) (%)"

#. Translators: The label of a control to choose the volume of a beep in the
#. right channel.
#: addon/appModules/msedge/interface/beepDialogs.py:21
msgid "&Right volume (%)"
msgstr "右声道音量(&R) (%)"

#. Translators: The label of a control to choose the silence following a beep.
#: addon/appModules/msedge/interface/beepDialogs.py:23
msgid "&Pause after this beep (ms)"
msgstr "该提示音后的停顿(&P) (ms)"

#. Translators: How one beep of a beep pattern is presented in the list of
#. beeps.
#: addon/appModules/msedge/interface/beepDialogs.py:30
#, python-brace-format
msgid ""
"{frequency} Hz, {length} ms, left {leftVolume}%, right {rightVolume}%, pause "
"{pause} ms"
msgstr ""
"{frequency} Hz，{length} ms，左 {leftVolume}%，右 {rightVolume}%，停顿 "
"{pause} ms"

#. Translators: The title of the dialog to add or edit one beep of a beep
#. pattern.
#: addon/appModules/msedge/interface/beepDialogs.py:63
msgid "Beep"
msgstr "提示音"

#. Translators: The label of a button to hear the beep which is being edited.
#: addon/appModules/msedge/interface/beepDialogs.py:77
msgid "&Test"
msgstr "试听(&T)"

