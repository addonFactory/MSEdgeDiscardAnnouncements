msgstr "播放序列(&P)"

#. Translators: The label of the combo box to choose what NVDA does with the
#. selected notification.
#: addon/appModules/msedge/interface/panel.py:55
msgid "&Action"
msgstr "操作(&A)"

#. Translators: The label of a check box to turn the selected setting on or
#. off.
#: addon/appModules/msedge/interface/panel.py:65
msgid "Ena&bled"
msgstr "启用(&B)"

#. Translators: The label of a check box to speak a message of your own instead
#. of Edge's one.
#: addon/appModules/msedge/interface/panel.py:74
msgid "Speak a &custom message"
msgstr "朗读自定义消息(&C)"

#. Translators: The label of the field holding the message to speak for the
#. selected notification.
#: addon/appModules/msedge/interface/panel.py:81
msgid "&Message"
msgstr "消息(&M)"

#. Translators: The label of the field holding the wave file played for the
#. notification.
#: addon/appModules/msedge/interface/panel.py:90
msgid "Wave &file"
msgstr "音频文件(&F)"

#. Translators: The label of a control to choose how loud the wave file is
#. played.
#: addon/appModules/msedge/interface/panel.py:97
msgid "Wave file &volume (%)"
msgstr "音频文件音量(&V) (%)"

#. Translators: The label of the list of Microsoft Edge notifications.
#: addon/appModules/msedge/interface/panel.py:113
msgid "&Notification"
msgstr "通知(&N)"

#. Translators: The label of a button opening the dialog to build the beeps of
